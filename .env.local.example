# Bu dosyayı .env.local olarak kopyala ve kendi değerlerini doldur.
# setup.sh çalıştırıldığında otomatik kopyalanır.

# ─────────────────────────────────────────────
# Firebase (kullanacaksan doldur, gerekmiyorsa sil)
# Detaylar: src/extras/firebase-setup.md
# ─────────────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (sadece server-side — NEXT_PUBLIC ile başlama)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────
# Supabase (kullanacaksan doldur, gerekmiyorsa sil)
# Detaylar: src/extras/supabase-setup.md
# ─────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # sadece server-side, asla NEXT_PUBLIC değil
